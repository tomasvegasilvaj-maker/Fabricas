# Copiá este archivo a .env.local para correr en tu compu. En Vercel van en Settings → Environment Variables.

# Supabase (proyecto paso-a-paso). La clave es la "service_role" / secret key: solo servidor, nunca en el navegador.
SUPABASE_URL=https://izdfvzjkypcqxuspsxsm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=

# Contraseña para entrar a la app
APP_PASSWORD=

# URL pública de la app (para que el motor se despierte solo)
APP_URL=http://localhost:3000

# Opcionales
# GOOGLE_PLACES_API_KEY=      # mejora la investigación (Place ID, fotos del local, link de reseñas)
# WEBHOOK_SECRET=             # habilita POST /api/webhook/pedido para el formulario de clientes
# TOPE_USD_POR_PLACA=2.5      # tope de gasto en IA por placa
# SESSION_SECRET=             # firma de la sesión; si falta, se arma con la clave de Supabase y APP_PASSWORD
# La clave del motor no va acá: la app usa una derivada de la de Supabase y el cron una que vive en Vault (ver README).
